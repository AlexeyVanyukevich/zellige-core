#!/usr/bin/env bash
#
# One entry point for every way of running this project.
# `./run` with no arguments prepares the checkout and lists the scenarios.
#
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

# This script is what installs dependencies, so it cannot source out of node_modules before the
# kit is there. The test is for the file rather than the directory: a checkout installed before
# the kit became a dependency has node_modules without it.
[ -f node_modules/charter/core/lib.sh ] ||
  GITHUB_TOKEN="${GITHUB_TOKEN:-$(gh auth token 2>/dev/null || true)}" npm install
source node_modules/charter/core/lib.sh

prepare() {
  need_node
  need_deps
  need_plugins
  need_hooks
}

# The browsers run in the Playwright image matching the installed runner, so screenshots render
# the same on every machine; the runner stays on the host and the playground with it. The
# image tag is read from the installed package, never written here.
BROWSER_PORT="${ZELLIGE_BROWSER_PORT:-3555}"

browser_suite() {
  need_docker
  local version name
  version="$(node -p "require('@playwright/test/package.json').version")"
  name="zellige-core-browsers-$$"

  step "Starting Playwright ${version}'s browsers in Docker"
  docker run --detach --rm --init --ipc=host --name "$name" \
    --publish "127.0.0.1:${BROWSER_PORT}:${BROWSER_PORT}" \
    --volume zellige-core-npm:/root/.npm \
    "mcr.microsoft.com/playwright:v${version}-noble" \
    npx --yes "playwright@${version}" run-server --port "$BROWSER_PORT" --host 0.0.0.0 >/dev/null
  trap "docker stop '$name' >/dev/null 2>&1 || true" EXIT

  local waited=0
  until docker logs "$name" 2>&1 | grep -q 'Listening on'; do
    [ "$waited" -lt 120 ] || die "The browser server did not start." "Read: docker logs $name"
    sleep 1
    waited=$((waited + 1))
  done

  step "Browser suite"
  ZELLIGE_BROWSER_WS="ws://127.0.0.1:${BROWSER_PORT}/" npx playwright test "$@"
}

scenario_test() {
  prepare
  browser_suite "$@"
  ok "Browser suite passed"
}

scenario_dev() {
  prepare
  step "Playground at http://127.0.0.1:5180"
  npx vite
}

scenario_check() {
  prepare
  step "Formatting"
  npx prettier --check .
  step "Types"
  npx tsc
  step "Lint"
  npx oxlint --deny-warnings
  step "Markup"
  npx html-validate contract playground
  npx --no charter scan contract playground
  browser_suite
  ok "All checks passed"
}

usage() {
  cat <<EOF
Usage: ./run <scenario>

  ${BOLD}dev${OFF}     the playground, served by Vite
  ${BOLD}test${OFF}    the browser suite, in the Playwright image; arguments go to playwright test
  ${BOLD}check${OFF}   formatting, types, lint, markup and the browser suite
EOF
}

SCENARIO="${1:-}"
[ $# -gt 0 ] && shift

case "$SCENARIO" in
  check)        scenario_check ;;
  test)         scenario_test "$@" ;;
  dev)          scenario_dev ;;
  '')           prepare; ok "Ready"; usage ;;
  -h|--help)    usage ;;
  *)            usage; die "Unknown scenario: $SCENARIO" ;;
esac
